rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // എല്ലാവർക്കും Published Exams കാണാം
    match /exams/{examId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // പൊതുജനങ്ങൾക്ക് Study Materials കാണാം
    match /studyMaterials/{materialId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // പൊതുജനങ്ങൾക്ക് Announcements കാണാം
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Exam എഴുതുന്നവർക്ക് Result create ചെയ്യാം.
    // Results മുഴുവൻ കാണാനും edit/delete ചെയ്യാനും Admin login ആവശ്യമാണ്.
    match /examResults/{resultId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
